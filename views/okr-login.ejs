<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BYU Ryde Admin &amp; OKR Portal</title><link rel="stylesheet" href="/css/okr.css"></head><body><main><a href="/">Back to The Ryde</a><h1>Admin &amp; OKR Portal</h1><p>Sign in to view the dashboard and maintain records.</p><p role="alert"><%= error %></p><% if(configured){ %><form action="/okr/login" method="post"><label>Email <input type="email" name="user_email" required autocomplete="username" maxlength="254"></label><label>Password <input type="password" name="user_password" required autocomplete="current-password" maxlength="256"></label><button type="submit">Sign in</button></form><% }else{ %><p>The administrator portal is not configured yet.</p><% } %></main></body></html>

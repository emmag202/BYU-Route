<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ryde team dashboard</title><link rel="stylesheet" href="/css/okr.css"></head><body><main><a href="/">Back to The Ryde</a><h1>Team dashboard</h1><p>Enter the shared team password to view our key results.</p><p role="alert"><%= error %></p><% if(configured){ %><form action="/okr/login" method="post"><label>Team password <input type="password" name="password" required autocomplete="current-password" style="padding:12px;max-width:100%;margin:8px 0"></label> <button type="submit">Open dashboard</button></form><% }else{ %><p>The team dashboard is not configured yet.</p><% } %></main></body></html>

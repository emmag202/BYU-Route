# Render / local Express: invokes the existing Lambda; never connects directly to RDS.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
AWS_REGION=us-east-1
RYDE_LAMBDA_FUNCTION_ARN=arn:aws:lambda:us-east-1:YOUR_ACCOUNT_ID:function:byu-ryde-api
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN is needed only when using temporary AWS credentials.

# Lambda console only: NODE_ENV=production and the following DB settings.
# Do not set DB credentials on Render or in browser files.
# DB_HOST=<existing RDS endpoint>
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=<authorized demo database login>
# DB_PASSWORD=<enter privately in AWS>
# DB_SSL_CA=/var/task/global-bundle.pem
# DEMO_SETUP_ENABLED=true only during the one-time server.setup step.
